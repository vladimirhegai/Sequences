{
  "name": "sequences-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Sequences — agent-first motion graphics editor for SaaS product video, built on HyperFrames.",
  "type": "module",
  "bin": {
    "sequences": "./apps/sequences/src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:perf": "node scripts/perf-budget.mjs",
    "test:forge-ui": "node scripts/forge-ui-smoke.mjs",
    "test:golden": "node scripts/golden-renders.mjs fixtures/sequences/starter",
    "test:ci": "npm run typecheck && npm test && npm run test:perf",
    "sequences": "node apps/sequences/src/cli.ts app examples/sequences/demo-promo",
    "sequences:exe": "node apps/sequences/src/cli.ts exe examples/sequences/demo-promo",
    "sequences:web": "node apps/sequences/src/cli.ts studio examples/sequences/demo-promo",
    "forge": "node apps/forge/src/cli.ts serve",
    "compile:example": "node apps/sequences/src/cli.ts compile examples/sequences/demo-promo",
    "render:example": "node apps/sequences/src/cli.ts render examples/sequences/demo-promo"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "fast-check": "^4.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
