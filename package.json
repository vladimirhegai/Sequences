{
  "name": "sequences-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Sequences — agent-first motion graphics editor for SaaS product video, built on HyperFrames.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run && npm run test:worker",
    "test:worker": "npm test --prefix apps/slack/codex-worker",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ci": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "fast-check": "^4.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
